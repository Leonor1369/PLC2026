[
    {
        "id": "valor numerico",
        "expreg": "\\d+"
    },
    {
        "id": "identificador de variavel",
        "expreg": "\\?[a-zA-Z0-9]+"
    },
    {
        "id": "identificador de linguagem",
        "expreg": "@[A-Za-z0-9]{2}"
    },
    {
        "id": "SKIP",
        "expreg": "\\s+"
    },
    {
        "id": "STRING",
        "expreg": "('[^']*')|(\"[^\"]*\")"
    },
    {
        "id": "Comment",
        "expreg": "\\#.*"
    },
    {
        "id": "Reserved word",
        "expreg": "(select|where|LIMIT|OFFSET|ORDER|BY|ASC|DESC|AND|OR|NOT|BETWEEN|IN|IS|NULL|LIKE)(?![a-zA-Z0-9])"
    },
    {
        "id": "identificador de conceito",
        "expreg": "[a-zA-Z0-9]+"
    },
    {
        "id": "delimitador",
        "expreg":"\\.|\\{|\\}"
    },
    {
        "id": "ERRO",
        "expreg": "."
    }
]